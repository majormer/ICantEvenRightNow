package-as: ICantEvenRightNow

enable-nolib-creation: no

ignore:
  - README.md
  - docs
  - .git
  - .gitignore
  - .env.example
  - .github
  - .lua-ls
  - .githooks
  - .gitattributes
  - .editorconfig
  - .git-blame-ignore-revs
  - .luarc.json
  - scripts
  - build
  - .release
  - "*.zip"
  - "*.log"

manual-changelog:
  filename: CHANGELOG.md
  markup-type: markdown
