#!/bin/sh
# Static checks before every commit. Enable once per clone:
#   git config core.hooksPath .githooks
# Skip in an emergency with: git commit --no-verify
if command -v pwsh >/dev/null 2>&1; then PS=pwsh; else PS=powershell.exe; fi
exec "$PS" -NoProfile -ExecutionPolicy Bypass -File scripts/Test-Addon.ps1 -Hook
